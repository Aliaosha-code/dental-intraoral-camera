{
  "name": "dental-intraoral-camera",
  "private": true,
  "version": "1.0.0",
  "description": "口腔内窥相机系统 — 专业口腔医疗影像桌面工作站（Windows / Apple Silicon macOS）",
  "author": "Dental Imaging Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aliaosha-code/dental-intraoral-camera.git"
  },
  "bugs": {
    "url": "https://github.com/Aliaosha-code/dental-intraoral-camera/issues"
  },
  "homepage": "https://github.com/Aliaosha-code/dental-intraoral-camera#readme",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5178",
    "build": "vite build",
    "preview": "vite preview --port 4178",
    "start": "npm run electron:start",
    "electron:start": "npm run build && node scripts/start-electron.mjs",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:mac:dir": "npm run build && electron-builder --mac --arm64 --dir",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.dental.intraoralcamera",
    "productName": "口腔内窥相机系统",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/app-icon.png",
      "electron/app-icon.icns",
      "electron/app-icon.ico",
      "LICENSE",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.medical",
      "icon": "electron/app-icon.icns",
      "minimumSystemVersion": "12.0",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "口腔内窥相机系统需要访问 USB 摄像头以显示实时口内画面。",
        "NSHighResolutionCapable": true
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/app-icon.ico"
    }
  }
}
